# The build context is an allowlist. Never send the surrounding product archive.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!vite.config.ts
!tsconfig.json
!tsconfig.node.json
!client/
!client/**
!shared/
!shared/**
!server/
!server/**
