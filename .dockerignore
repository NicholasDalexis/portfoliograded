**/.env
**/.env.*
**/node_modules/**
**/data/**
**/shots*/**
**/tests/**
**/*.test.ts
**/*.test.tsx
**/*.pem
**/*.key
**/*service-account*
**/*serviceAccount*
**/__manus__/**
**/.DS_Store
