# ============================================================
# PortfolioGraded — Environment Variables
# Copy to .env for local dev. In Railway, set these in the
# service "Variables" tab.
# ============================================================

# Runtime
NODE_ENV=development
PORT=3000
# Public base URL of the app (used for Stripe redirects + webhooks)
# Local: http://localhost:3000   Prod: https://portfoliograded.com
APP_URL=http://localhost:3000

# ----- Database (MySQL) -----
# Railway: add a MySQL plugin and reference its connection string.
# Railway exposes it automatically; locally use your own MySQL URL.
DATABASE_URL=mysql://user:password@host:3306/portfoliograded

# ----- Clerk (authentication) -----
# Dashboard: https://dashboard.clerk.com  → API Keys
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Frontend needs the publishable key too (Vite inlines VITE_* at build time)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# ----- Anthropic (audit enrichment, Claude Opus 4.8) -----
# https://console.anthropic.com  → API Keys
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-opus-4-8

# ----- Stripe (Pro subscription) -----
# https://dashboard.stripe.com  → Developers → API keys
STRIPE_SECRET_KEY=sk_test_xxx
# Create a recurring Price for Pro and paste its price id (price_xxx)
STRIPE_PRICE_ID_PRO=price_xxx
# From the webhook endpoint you create pointing at /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ----- Owner -----
# Email that should be granted the "admin" role on first sign-in.
OWNER_EMAIL=you@example.com
